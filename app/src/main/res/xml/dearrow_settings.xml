<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/dearrow">

    <Preference
        app:iconSpaceReserved="false"
        android:key="@string/dearrow_home_page_key"
        android:summary="@string/dearrow_home_page_summary"
        android:title="@string/dearrow_home_page_title"/>

    <Preference
        app:iconSpaceReserved="false"
        android:key="@string/dearrow_privacy_key"
        android:summary="@string/dearrow_privacy_summary"
        android:title="@string/dearrow_privacy_title"/>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/settings">

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:defaultValue="true"
            android:key="@string/dearrow_enable_key"
            android:summary="@string/dearrow_enable_summary"
            android:title="@string/dearrow_enable_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="true"
            android:key="@string/dearrow_replace_titles_key"
            android:summary="@string/dearrow_replace_titles_summary"
            android:title="@string/dearrow_replace_titles_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="true"
            android:key="@string/dearrow_auto_format_titles_key"
            android:summary="@string/dearrow_auto_format_titles_summary"
            android:title="@string/dearrow_auto_format_titles_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_replace_titles_key"
            android:defaultValue="true"
            android:key="@string/dearrow_mark_replaced_titles_key"
            android:summary="@string/dearrow_mark_replaced_titles_summary"
            android:title="@string/dearrow_mark_replaced_titles_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="true"
            android:key="@string/dearrow_replace_thumbnails_key"
            android:summary="@string/dearrow_replace_thumbnails_summary"
            android:title="@string/dearrow_replace_thumbnails_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_replace_thumbnails_key"
            android:defaultValue="true"
            android:key="@string/dearrow_random_thumbnails_key"
            android:summary="@string/dearrow_random_thumbnails_summary"
            android:title="@string/dearrow_random_thumbnails_title"/>
    </PreferenceCategory>
</PreferenceScreen>
